<Project Sdk="Microsoft.NET.Sdk">
  <!-- App per l'area di notifica di Windows: interfaccia di configurazione e server MCP incluso (jobdossiers-mcp.exe accanto all'eseguibile).
       Si compila anche da macOS grazie a EnableWindowsTargeting; si prova solo su Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jobdossiers</AssemblyName>
    <RootNamespace>Jobdossiers.Win</RootNamespace>
    <Version>0.2.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jobdossiers.Core\Jobdossiers.Core.csproj" />
  </ItemGroup>
</Project>
