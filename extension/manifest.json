{
  "manifest_version": 3,
  "name": "Jobdossiers",
  "version": "0.2.3",
  "description": "Salva in Jobdossiers l'annuncio che stai guardando, con un clic. Cifra e invia l'app Jobdossiers su questo computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Jobdossiers: apri il pannello",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "leggi-pagina": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Leggi questa pagina nel pannello Jobdossiers"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
